# Committed template. Copy to .env (gitignored) if you want to override the default locally:
#   cp .env.example .env
#
# Baked into the bundle at build time by Vite (not read at runtime) — the URL the browser will
# call for the maverik backend API. Must match the host-published port of the `maverik` service
# in docker-compose.yml (default 5088).
VITE_API_BASE_URL=http://localhost:5088
